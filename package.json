{
  "name": "fastify-bun-starter-root",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/libs/*"
  ],
  "scripts": {
    "start": "bun apps/api/app.ts",
    "bench:json": "bun --expose-gc scripts/bench_json_parse.ts",
    "bench:logger": "bun --expose-gc scripts/bench_logger.js",
    "bench:validator": "bun --expose-gc scripts/bench_validator.js",
    "build": "docker build --build-arg \"BUILD_TS=$(bun -e 'console.log(new Date().toISOString());')\" --target prod -t fastify-bun-starter:latest . && docker build --build-arg \"BUILD_TS=$(bun -e 'console.log(new Date().toISOString());')\" --target scan . && docker build --build-arg \"BUILD_TS=$(bun -e 'console.log(new Date().toISOString());')\" --target logs --output type=local,dest=./build-logs .",
    "build:grype": "docker build --build-arg \"BUILD_TS=$(bun -e 'console.log(new Date().toISOString());')\" --target scan .",
    "clean": "bun scripts/rimraf.ts -- -q var dist build build-logs coverage node_modules .cache NUL *.log *.cpuprofile",
    "cluster": "bun apps/api/cluster.ts",
    "dev": "bun --hot apps/api/app.ts",
    "kill": "bun scripts/kill.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "publish:npm": "npm login && npm publish --access public",
    "release": "bun scripts/release.ts",
    "rimraf": "bun scripts/rimraf.ts",
    "test": "bun run lint:fix && bun scripts/run-tests.ts --port 4000 && bun scripts/coverage-report.ts",
    "test:verbose": "bun run lint && tsc && bun scripts/run-tests.ts --port 4000 --verbose && bun scripts/coverage-report.ts",
    "test:ci": "bun test ci",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.8.1",
    "@types/node": "^24.13.3",
    "fastify": "^5.11.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@happy-dom/global-registrator": "^20.11.1",
    "@types/bun": "^1.3.14"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "bin": {
    "fastify-bun-starter": "scripts/bin.js"
  },
  "files": [
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "fastify",
    "bun",
    "typescript",
    "rest-api",
    "cli",
    "starter",
    "template"
  ],
  "author": "eram@weblegions.com",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/eram/fastify-bun-starter.git"
  },
  "bugs": {
    "url": "https://github.com/eram/fastify-bun-starter/issues"
  },
  "homepage": "https://github.com/eram/fastify-bun-starter#readme"
}
