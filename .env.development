# Development environment configuration
NODE_ENV=development

# Logging configuration
LOG_FORMAT=line                         # Use line format for development (json for production)

# Server configuration
HOST=0.0.0.0
PORT=3000

# TLS/HTTPS configuration (optional - enables HTTP/2 when configured)
# Generate dev certs: mkcert -install && mkcert localhost 127.0.0.1 ::1
# TLS_CERT_PATH=./certs/localhost+2.pem
# TLS_KEY_PATH=./certs/localhost+2-key.pem

# HTTP/2 settings (only applies when HTTPS enabled)
# HTTP2_INITIAL_WINDOW_SIZE=1048576      # 1 MiB: reduces early stalls (default)
# HTTP2_HEADER_TABLE_SIZE=16384          # 16 KiB: enough for typical header sets (default)
# HTTP2_MAX_CONCURRENT_STREAMS=100       # Tune per backend capacity (default)
# HTTP2_SESSION_TIMEOUT=60000            # Close idle sessions after 60s (default)

# Cluster configuration
# CLUSTER_WORKERS=2          # Number of workers (defaults to CPU count, max 32)
CLUSTER_RESTART_MAX=10       # Max restarts per window (default: 10)
CLUSTER_RESTART_WINDOW=60000 # Restart window in ms (default: 60000)
CLUSTER_SHUTDOWN_TIMEOUT=5000 # Shutdown timeout in ms (default: 5000)

# Security configuration
CORS_ALLOWED_ORIGINS=*                    # Comma-separated origins or "*" (use specific origins in production)
RATE_LIMIT_WINDOW_MS=60000                # Rate limit window: 1 minute (default)
RATE_LIMIT_MAX_REQUESTS=10000             # Max requests per window (default: 100)
MAX_BODY_SIZE=10mb                        # Request body size limit (default: 10mb)
MAX_URL_LENGTH=2048                       # URL length limit for params (default: 2048)
ALLOWED_HOSTS=localhost,127.0.0.1         # DNS rebinding protection for local development (leave empty in production)

# Transpile configuration
TRANSPILE_CACHE_MAX_AGE=60                # Cache max-age for transpiled files in seconds (default: 3600)
AT_TERMINATE_TIMEOUT=1000000              # Dont timeout in dev >> default: 30000 ms

# Client-side vars
C_LOG_LEVEL=debug                       # Client-side log level (debug|info|warn|error)
